# Hostel Maintenance Tracker - API image (Node.js + Express)
# Build:  podman build -t hmt-backend:1.0 -f Containerfile .
FROM docker.io/library/node:20-alpine

LABEL org.opencontainers.image.title="hmt-backend" \
      org.opencontainers.image.description="Hostel Maintenance Tracker REST API" \
      org.opencontainers.image.version="1.0"

ENV NODE_ENV=production \
    PORT=5000

WORKDIR /app

# Copy only the dependency list first, so this layer is cached when only code changes
COPY package*.json ./
RUN npm ci --omit=dev && npm cache clean --force

COPY . .

# Run as the unprivileged "node" user that ships with the image, not as root
RUN chown -R node:node /app
USER node

EXPOSE 5000

# Container reports healthy only when the API answers and is connected to MongoDB
HEALTHCHECK --interval=10s --timeout=3s --start-period=15s --retries=3 \
  CMD wget -qO- http://127.0.0.1:5000/api/health | grep -q connected || exit 1

CMD ["node", "server.js"]
